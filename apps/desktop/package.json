{
  "name": "@torveai/desktop",
  "productName": "Torve Desktop",
  "version": "0.2.65",
  "private": true,
  "description": "Torve Desktop — Direct Cloud AI Router & App Manager",
  "author": "Torve <hello@torveai.com>",
  "homepage": "https://torveai.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/jisunahamed/torve-seed.git"
  },
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "ensure:workspace-deps": "pnpm -C ../../packages/api-adapter build && pnpm -C ../../packages/node build",
    "brand:electron-dev": "node ./scripts/brand-electron-dev.mjs",
    "models:update-metadata": "pnpm -C ../../packages/node build && node ./scripts/update-model-metadata.mjs",
    "ensure:native": "npm run ensure:runtime-native",
    "ensure:runtime-native": "node ./scripts/ensure-runtime-native-modules.mjs",
    "prebuild": "npm run ensure:workspace-deps && npm run brand:electron-dev && npm run ensure:native && node ../../scripts/remove-paths.mjs dist",
    "predev": "npm run ensure:workspace-deps && npm run brand:electron-dev && npm run ensure:native && node ../../scripts/remove-paths.mjs dist/main",
    "prestart": "npm run ensure:workspace-deps && npm run brand:electron-dev && npm run ensure:native",
    "build": "npm run build:main && npm run build:renderer && npm run build:harden",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build:harden": "node ./scripts/after-pack-harden.mjs --prepack",
    "test": "node ./scripts/run-tests.mjs",
    "test:renderer": "vitest run --dir src/renderer",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json --noEmit",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:debug": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron:debug\"",
    "dev:instance": "node ./scripts/dev-instance.mjs",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "dev:electron": "node ./scripts/dev-electron.mjs",
    "dev:electron:debug": "node ./scripts/dev-electron.mjs --debug-runtime",
    "start": "electron .",
    "start:debug": "cross-env TORVE_DESKTOP_DEBUG=1 electron . --debug-runtime",
    "prepare-dist": "node ./scripts/prepare-dist.mjs && node ./scripts/after-pack-harden.mjs --prepack",
    "dist": "npm run build && npm run prepare-dist && node scripts/dist.mjs",
    "dist:mac": "npm run build && node scripts/release-mac.mjs --no-publish",
    "release:mac": "npm run build && node scripts/release-mac.mjs",
    "dist:win": "npm run build && npm run prepare-dist && node ./scripts/dist-win.mjs",
    "release:win": "npm run build && npm run prepare-dist && node scripts/release-win.mjs",
    "dist:linux": "npm run build && npm run prepare-dist && electron-builder --config electron-builder.linux.cjs --linux",
    "release:linux": "npm run build && npm run prepare-dist && electron-builder --config electron-builder.linux.cjs --linux --publish always"
  },
  "dependencies": {
    "@torveai/api-adapter": "workspace:*",
    "@torveai/node": "workspace:*",
    "better-sqlite3": "^12.6.2"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/notarize": "^3.1.1",
    "@hugeicons/core-free-icons": "^4.0.0",
    "@hugeicons/react": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.3.5",
    "@torveai/ui": "workspace:*",
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.0",
    "clsx": "^2.1.0",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "electron": "^31.6.0",
    "electron-builder": "^25.1.8",
    "javascript-obfuscator": "^5.11.0",
    "lucide-react": "^1.81.0",
    "marked": "^17.0.4",
    "motion": "^14.14.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-loading-skeleton": "^3.5.0",
    "sass": "^1.97.3",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.1",
    "yaml": "^2.8.2"
  }
}
