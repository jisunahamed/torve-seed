# =============================================================================
# torve-seed — gateway + P2P defaults
# Copy to .env or .env.local (loaded via apps/cli/src/env/load-env.ts).
# Precedence: process.env > TORVE_ENV_FILE > .env.local > .env
# Rebrand target: @torveai/*, bin `torve` (currently still `torve` in code).
# =============================================================================

# -- Node identity — 64-char hex secp256k1 private key seed.
# When set, overrides all other identity storage (file, custom IdentityStore).
# Cleared from process environment immediately after read.
# Recommended for servers: inject from a secrets manager.
# Will be renamed to TORVE_IDENTITY_HEX after rebrand; both names accepted during migration.
# TORVE_IDENTITY_HEX=
# TORVE_IDENTITY_HEX=

# -- Debug
TORVE_DEBUG=0
VITE_TORVE_DEBUG=0

# -- Optional: override env file path for runtime env loading
# TORVE_ENV_FILE=.env

# -- Buyer peer discovery runtime override (milliseconds). Durable default lives in config.json.
# TORVE_BUYER_METADATA_FETCH_TIMEOUT_MS=1500

# -- Settlement runtime (requires config.payments.crypto in config.json)
# Recommended for production sellers: use a dedicated Base JSON-RPC endpoint.
# TORVE_BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/...
# TORVE_ENABLE_SETTLEMENT=true
# TORVE_SETTLEMENT_IDLE_MS=30000
# TORVE_DEFAULT_ESCROW_USDC=1
# TORVE_AUTO_FUND_ESCROW=true
# TORVE_SELLER_WALLET_ADDRESS=0x...

# -- Comparable retail prices for `torve buyer activity` savings (optional).
# Any endpoint serving the OpenRouter-compatible models schema works, e.g.:
# TORVE_COMPARABLE_PRICES_URL=https://openrouter.ai/api/v1/models
# Release builds bake in a default; set this empty to disable the baseline.

# =============================================================================
# Supabase auth bridge — reuse existing Torve Supabase project
# Single account for web + CLI + Desktop.
# Project ref: yvbrvrnjlonqoxzpikbf.supabase.co
# See FORK-AUTH.md and apps/cli/src/auth/supabase-jwt.ts for verification details.
# All vars below are optional until the bridge is wired; uncomment to enable.
# Never put a service_role key here — CLI/gateway only use the anon key + user JWTs.
# =============================================================================

# Canonical Supabase project URL (server-side). Also accepted as NEXT_PUBLIC_SUPABASE_URL
# for dev reuse of apps/web/.env.local. Must be the same project as the website.
# SUPABASE_URL=https://yvbrvrnjlonqoxzpikbf.supabase.co

# Public anon key — safe to expose, but this repo performs JWT verification on the server/gateway.
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT audience — Supabase Auth sets aud=authenticated on access tokens.
# Override only for self-hosted Supabase.
# SUPABASE_JWT_AUDIENCE=authenticated

# Bootstrap superadmin email — must match TORVEAI_SUPERADMIN_EMAIL in apps/web
# and SUPABASE_ADMIN_EMAIL in apps/api. Lower-cased for comparison.
# SUPABASE_ADMIN_EMAIL=admin@torveai.com
# TORVEAI_SUPERADMIN_EMAIL=admin@torveai.com

# Canonical web origin for OAuth redirects and bridge callbacks (must be https in prod).
# WEB_PUBLIC_ORIGIN=https://torveai.com
# TORVE_WEB_ORIGIN=https://torveai.com

# Gateway origin that the web bridge redirects back to (loopback or deep link handler).
# For CLI loopback: http://127.0.0.1:<ephemeral>
# For Desktop deep link: torve://auth/callback
# TORVE_GATEWAY_ORIGIN=http://127.0.0.1:8787

# Optional extra origins accepted by Server Actions / bridge (comma-separated, no trailing slash).
# WEB_SERVER_ACTION_ORIGINS=torveai.com

# Management API base URL (server-to-server, Bearer = user's Supabase access token).
# TORVEAI_MANAGEMENT_API_URL=https://api.torveai.com
